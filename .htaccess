<IfModule mod_rewrite.c>
    RewriteEngine On

    # The Laragon auto-vhost may point at the project root instead of public/.
    # Serve existing public assets directly.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Send application requests to Laravel's public front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>
