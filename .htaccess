<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Serve files/directories from Laravel public/ when Apache is still
    # pointing at the project root (e.g. a local Laragon auto-vhost).
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.+)$ public/$1 [L]

    # Send every application request to Laravel's public front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>
